# Em desenvolvimento, o banco é criado em server/teap.db.
# No Railway, crie um Volume montado em /data e use:
# DATABASE_PATH=/data/teap.db
DATABASE_PATH=

# URL do frontend publicado na Vercel. Separe múltiplas URLs por vírgula.
# Exemplo: https://teap-quiz.vercel.app
CLIENT_ORIGIN=http://localhost:5173
